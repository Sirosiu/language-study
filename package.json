{
  "name": "sirosiu-language-study",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A portable language course for GitHub Pages, with audio, PDFs and Obsidian downloads.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "validate": "node scripts/validate.mjs",
    "start": "node scripts/serve.mjs",
    "test": "npm run test:unit && node node_modules/@playwright/test/cli.js test",
    "test:unit": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "obsidian": "^1.14.4"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "dompurify": "^3.5.0",
    "esbuild-wasm": "^0.28.2",
    "fflate": "^0.8.3",
    "marked": "^18.3.0"
  }
}
